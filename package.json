{
  "name": "le-donjon",
  "version": "0.1.0",
  "private": true,
  "description": "Le Donjon — prototype de jeu de donjon multijoueur piloté par le chat (phase 1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "dev": "vite build && tsx src/server/index.ts",
    "dev:client": "vite",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "bots": "tsx scripts/bots.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tmi.js": "^1.8.5",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
